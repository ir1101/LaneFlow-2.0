{
  "Comment": "LaneFlow: route each PDF to a right-sized Lambda lane, or to the baseline for comparison runs.",
  "StartAt": "ChooseMode",
  "States": {
    "ChooseMode": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.mode", "StringEquals": "baseline", "Next": "BaselineExtract" }
      ],
      "Default": "Classify"
    },
    "Classify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${ClassifierArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2
        }
      ],
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" } ],
      "Next": "ChooseLane"
    },
    "ChooseLane": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.lane", "StringEquals": "light", "Next": "LightExtract" }
      ],
      "Default": "HeavyExtract"
    },
    "LightExtract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${LightExtractArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2
        }
      ],
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" } ],
      "Next": "MarkCompleted"
    },
    "HeavyExtract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${HeavyExtractArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2
        }
      ],
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" } ],
      "Next": "MarkCompleted"
    },
    "BaselineExtract": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${BaselineExtractArn}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2
        }
      ],
      "Catch": [ { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" } ],
      "Next": "MarkCompleted"
    },
    "MarkCompleted": {
      "Comment": "Direct DynamoDB integration: no Lambda needed to update the job record.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": { "pk": { "S.$": "$.docId" }, "sk": { "S": "JOB" } },
        "UpdateExpression": "SET #s = :s, #l = :l, #p = :p, #c = :c",
        "ExpressionAttributeNames": { "#s": "status", "#l": "lane", "#p": "pages", "#c": "completedAt" },
        "ExpressionAttributeValues": {
          ":s": { "S": "COMPLETED" },
          ":l": { "S.$": "$.lane" },
          ":p": { "N.$": "States.Format('{}', $.pages)" },
          ":c": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": null,
      "Retry": [ { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 } ],
      "Next": "NotifySuccess"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${TopicArn}",
        "Subject": "LaneFlow: document processed",
        "Message.$": "States.Format('{} processed in the {} lane: {} pages, {} words. Document ID {}.', $.key, $.lane, $.pages, $.words, $.docId)",
        "MessageAttributes": { "outcome": { "DataType": "String", "StringValue": "success" } }
      },
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": { "pk": { "S.$": "$.docId" }, "sk": { "S": "JOB" } },
        "UpdateExpression": "SET #s = :s, #e = :e, #f = :f",
        "ExpressionAttributeNames": { "#s": "status", "#e": "errorType", "#f": "failedAt" },
        "ExpressionAttributeValues": {
          ":s": { "S": "FAILED" },
          ":e": { "S.$": "$.error.Error" },
          ":f": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": null,
      "Retry": [ { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 } ],
      "Next": "SendToDeadLetterQueue"
    },
    "SendToDeadLetterQueue": {
      "Comment": "The failed job, with its error, is kept for 14 days so it can be inspected and redriven.",
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "${DeadLetterQueueUrl}",
        "MessageBody.$": "$"
      },
      "ResultPath": null,
      "Retry": [ { "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "MaxAttempts": 2, "BackoffRate": 2 } ],
      "Next": "NotifyFailure"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${TopicArn}",
        "Subject": "LaneFlow: processing failed",
        "Message.$": "States.Format('{} could not be processed ({}). Document ID {}. The job has been moved to the dead letter queue.', $.key, $.error.Error, $.docId)",
        "MessageAttributes": { "outcome": { "DataType": "String", "StringValue": "failure" } }
      },
      "ResultPath": null,
      "Next": "Failed"
    },
    "Failed": { "Type": "Fail", "Error": "ProcessingFailed", "Cause": "The job was moved to the dead letter queue; see the SNS failure notification." }
  }
}
